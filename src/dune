(library
 (public_name distsqlite-core)
 (name distcore)
 (modules distcore lock_free_queue binary_diff replication lease_state_machine protocol_constants build_config)
 (libraries threads unix))

(rule
 (targets libdistcore.so)
 (deps distcore_stubs.c distcore_main.c distcore.cma distcore.cmxa)
 (action
  (bash "
    # Set up opam environment
    eval $(opam env)
    
    # Get OCaml paths from opam environment
    OCAML_LIB=$(ocamlopt -config | grep standard_library: | cut -d' ' -f2)
    
    # Build shared library with OCaml objects - simplified approach
    gcc -fPIC -O3 -DCAML_NAME_SPACE -DNO_SIMD -c distcore_stubs.c -I $OCAML_LIB
    gcc -shared -fPIC -o libdistcore.so \
        distcore_stubs.o \
        .distcore.objs/native/distcore.o \
        .distcore.objs/native/distcore__*.o \
        -L $OCAML_LIB -lasmrun_shared \
        -lsqlite3 -lm -ldl -lpthread
  ")))