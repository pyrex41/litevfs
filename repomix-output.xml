<file path="test/unit/ocaml_unit_test.ml">
(** Comprehensive unit tests for OCaml modules *)

open Alcotest
open Bigarray
open Distcore

let test_vfs_write_queue () =
  let queue = VFS.WriteQueue.create ~capacity:10 in
  let event = {
    VFS.path = "/test.db";
    offset = 0L;
    data = Array1.create char c_layout 100;
    is_wal = false;
    fence_token = 1L;
  } in
  
  (* Test enqueue *)
  let success = VFS.WriteQueue.enqueue queue event in
  check bool "enqueue success" true success;
  
  (* Test pending count *)
  let count = VFS.WriteQueue.pending_count queue in
  check int "pending count" 1 count;
  
  (* Test dequeue *)
  let batch = VFS.WriteQueue.dequeue_batch queue ~max:1 in
  check int "batch size" 1 (Array.length batch);
  
  (* Verify data integrity *)
  let dequeued = batch.(0) in
  check string "path preserved" event.path dequeued.path;
  check int64 "offset preserved" event.offset dequeued.offset

let test_binary_diff_basic () =
  let old_data = Array1.create char c_layout 1000 in
  let new_data = Array1.create char c_layout 1000 in
  
  (* Fill with different patterns *)
  for i = 0 to 999 do
    Array1.set old_data i (Char.chr (i mod 256));
    Array1.set new_data i (Char.chr ((i + 1) mod 256));
  done;
  
  let diff = BinaryDiff.compute_diff ~old_db:old_data ~new_db:new_data ~page_size:256 in
  check bool "diff detected changes" true (List.length diff > 0)

let test_binary_diff_rolling_hash () =
  let data = Array1.create char c_layout 1000 in
  for i = 0 to 999 do
    Array1.set data i (Char.chr (i mod 256));
  done;
  
  let hashes = BinaryDiff.rolling_hash ~window_size:64 data in
  check bool "hashes generated" true (List.length hashes > 0);
  
  (* Verify hash consistency *)
  let hashes2 = BinaryDiff.rolling_hash ~window_size:64 data in
  check (list int32) "hash consistency" hashes hashes2

let test_replication_strategy () =
  let events = [|
    { VFS.path = "/test.db"; offset = 0L; 
      data = Array1.create char c_layout 100; is_wal = false; fence_token = 1L };
    { VFS.path = "/test.db"; offset = 100L; 
      data = Array1.create char c_layout 50; is_wal = false; fence_token = 2L };
  |] in
  
  let strategy = Replication.compute_strategy events in
  check bool "strategy computed" true (match strategy with
    | Replication.TxLog -> true
    | Replication.BulkSync -> true
    | Replication.Hybrid -> true
    | Replication.PageDiff -> true)

let test_replication_encoding () =
  let events = [|
    { VFS.path = "/test.db"; offset = 0L; 
      data = Array1.create char c_layout 10; is_wal = false; fence_token = 1L };
  |] in
  
  let encoded = Replication.encode_write_batch events in
  check bool "encoding successful" true (Array1.dim encoded > 0);
  
  (* Test round-trip encoding/decoding *)
  let decoded = Replication.decode_write_batch encoded in
  match decoded with
  | Ok decoded_events ->
      check int "decoded length" 1 (Array.length decoded_events);
      check string "path preserved" events.(0).path decoded_events.(0).path
  | Error _ ->
      fail "decoding failed"

let test_lease_state_machine () =
  open LeaseStateMachine in
  
  let initial_state = Follower { term = 1; voted_for = None } in
  let event = RequestVote { term = 2; candidate_id = "node1"; last_log_index = 0; last_log_term = 1 } in
  
  let new_state, actions = transition initial_state event in
  check bool "state transition occurred" true (new_state <> initial_state);
  check bool "actions generated" true (List.length actions >= 0)

let test_lease_state_machine_runner () =
  open LeaseStateMachine in
  
  let action_count = ref 0 in
  let action_handler action =
    incr action_count;
    match action with
    | SendMessage _ -> ()
    | UpdateStorage _ -> ()
    | SetElectionTimeout _ -> ()
  in
  
  let initial_state = Follower { term = 1; voted_for = None } in
  let runner = Runner.create initial_state action_handler in
  
  let event = RequestVote { term = 2; candidate_id = "node1"; last_log_index = 0; last_log_term = 1 } in
  Runner.handle_event runner event;
  
  check bool "actions executed" true (!action_count >= 0)

let test_memory_operations () =
  let arr1 = Array1.create char c_layout 1000 in
  let arr2 = Array1.create char c_layout 1000 in
  
  (* Fill with same data *)
  for i = 0 to 999 do
    let c = Char.chr (i mod 256) in
    Array1.set arr1 i c;
    Array1.set arr2 i c;
  done;
  
  (* Test memcmp *)
  let cmp_result = MemOps.memcmp arr1 0 arr2 0 1000 in
  check int "identical arrays compare equal" 0 cmp_result;
  
  (* Test hash computation *)
  let hash = MemOps.hash_simd arr1 0 1000 in
  check bool "hash computed" true (hash <> 0l)

let test_performance_monitoring () =
  let module P = PerfMonitor in
  
  (* Reset stats *)
  P.reset_stats ();
  let initial = P.get_stats () in
  check int64 "initial queue enqueues" 0L initial.queue_enqueues;
  
  (* Record some operations *)
  P.record_queue_enqueue ();
  P.record_queue_dequeue 5;
  P.record_bytes_processed 1024;
  
  let updated = P.get_stats () in
  check int64 "queue enqueues updated" 1L updated.queue_enqueues;
  check int64 "queue dequeues updated" 5L updated.queue_dequeues;
  check int64 "bytes processed updated" 1024L updated.bytes_processed

let test_api_functions () =
  let vfs = API.create_vfs () in
  check bool "VFS created" true (Option.is_some vfs);
  
  let queue = API.create_write_queue 100 in
  check bool "write queue created" true (queue <> Obj.repr ());
  
  let stats = API.get_performance_stats () in
  check bool "stats retrieved" true (List.length stats > 0)

let test_error_handling () =
  (* Test invalid inputs *)
  let invalid_queue = VFS.WriteQueue.create ~capacity:(-1) in
  check bool "invalid capacity handled" true (invalid_queue <> Obj.repr ());
  
  (* Test empty diff *)
  let empty_data = Array1.create char c_layout 0 in
  let diff = BinaryDiff.compute_diff ~old_db:empty_data ~new_db:empty_data ~page_size:256 in
  check bool "empty diff handled" true (List.length diff = 0)

let test_memory_bounds () =
  let data = Array1.create char c_layout 100 in
  
  (* Test bounds checking in memcmp - should handle gracefully *)
  let result = MemOps.memcmp data 0 data 50 60 in  (* This should exceed bounds *)
  check bool "bounds checking works" true (result = -1)

let test_concurrent_access () =
  let queue = VFS.WriteQueue.create ~capacity:1000 in
  let event = {
    VFS.path = "/test.db";
    offset = 0L;
    data = Array1.create char c_layout 10;
    is_wal = false;
    fence_token = 1L;
  } in
  
  (* Simulate concurrent enqueues *)
  let successes = ref 0 in
  for _ = 1 to 100 do
    if VFS.WriteQueue.enqueue queue event then
      incr successes
  done;
  
  check bool "concurrent enqueues handled" true (!successes > 0);
  
  let final_count = VFS.WriteQueue.pending_count queue in
  check bool "final count reasonable" true (final_count >= 0 && final_count <= 1000)

(* Test suite definition *)
let vfs_tests = [
  test_case "Write queue basic operations" `Quick test_vfs_write_queue;
]

let binary_diff_tests = [
  test_case "Basic diff computation" `Quick test_binary_diff_basic;
  test_case "Rolling hash consistency" `Quick test_binary_diff_rolling_hash;
]

let replication_tests = [
  test_case "Strategy computation" `Quick test_replication_strategy;
  test_case "Encoding round-trip" `Quick test_replication_encoding;
]

let lease_tests = [
  test_case "State machine transitions" `Quick test_lease_state_machine;
  test_case "State machine runner" `Quick test_lease_state_machine_runner;
]

let memory_tests = [
  test_case "Memory operations" `Quick test_memory_operations;
  test_case "Memory bounds checking" `Quick test_memory_bounds;
]

let monitoring_tests = [
  test_case "Performance monitoring" `Quick test_performance_monitoring;
]

let api_tests = [
  test_case "High-level API functions" `Quick test_api_functions;
]

let error_tests = [
  test_case "Error handling" `Quick test_error_handling;
]

let concurrency_tests = [
  test_case "Concurrent access" `Quick test_concurrent_access;
]

(* Main test runner *)
let () =
  run "DistCore OCaml Unit Tests" [
    ("VFS", vfs_tests);
    ("Binary Diff", binary_diff_tests);
    ("Replication", replication_tests);
    ("Lease State Machine", lease_tests);
    ("Memory Operations", memory_tests);
    ("Performance Monitoring", monitoring_tests);
    ("API", api_tests);
    ("Error Handling", error_tests);
    ("Concurrency", concurrency_tests);
  ]
</file>

<file path="test/unit/vfs_test.c.disabled">
#include <sqlite3.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <assert.h>
#include <unistd.h>
#include <sys/stat.h>

// Test framework
#define TEST_ASSERT(condition, message) \
    do { \
        if (!(condition)) { \
            fprintf(stderr, "FAIL: %s:%d: %s\n", __FILE__, __LINE__, message); \
            return 1; \
        } \
    } while (0)

#define TEST_SUCCESS() \
    do { \
        printf("PASS: %s\n", __func__); \
        return 0; \
    } while (0)

// Test fixture
static const char *test_db = "test_vfs.db";
static const char *test_wal = "test_vfs.db-wal";
static const char *test_shm = "test_vfs.db-shm";

// Clean up test files
static void cleanup_test_files() {
    unlink(test_db);
    unlink(test_wal);
    unlink(test_shm);
}

// Test VFS registration
int test_vfs_registration() {
    sqlite3_vfs *vfs = sqlite3_vfs_find("distsqlite");
    TEST_ASSERT(vfs != NULL, "DistSQLite VFS should be registered");
    TEST_ASSERT(strcmp(vfs->zName, "distsqlite") == 0, "VFS name should be 'distsqlite'");
    TEST_ASSERT(vfs->szOsFile > 0, "VFS file size should be positive");
    TEST_ASSERT(vfs->xOpen != NULL, "VFS xOpen should be implemented");
    TEST_ASSERT(vfs->xDelete != NULL, "VFS xDelete should be implemented");
    TEST_ASSERT(vfs->xAccess != NULL, "VFS xAccess should be implemented");
    TEST_SUCCESS();
}

// Test basic database operations
int test_basic_operations() {
    cleanup_test_files();
    
    sqlite3 *db;
    int rc = sqlite3_open_v2(test_db, &db, 
        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE,
        "distsqlite");
    TEST_ASSERT(rc == SQLITE_OK, "Should open database with distsqlite VFS");
    
    // Create table
    const char *create_sql = "CREATE TABLE test (id INTEGER PRIMARY KEY, value TEXT)";
    rc = sqlite3_exec(db, create_sql, NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should create table");
    
    // Insert data
    const char *insert_sql = "INSERT INTO test (value) VALUES ('hello'), ('world')";
    rc = sqlite3_exec(db, insert_sql, NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should insert data");
    
    // Query data
    sqlite3_stmt *stmt;
    rc = sqlite3_prepare_v2(db, "SELECT COUNT(*) FROM test", -1, &stmt, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should prepare query");
    
    rc = sqlite3_step(stmt);
    TEST_ASSERT(rc == SQLITE_ROW, "Should have result row");
    
    int count = sqlite3_column_int(stmt, 0);
    TEST_ASSERT(count == 2, "Should have 2 rows");
    
    sqlite3_finalize(stmt);
    sqlite3_close(db);
    
    cleanup_test_files();
    TEST_SUCCESS();
}

// Test WAL mode operations
int test_wal_mode() {
    cleanup_test_files();
    
    sqlite3 *db;
    int rc = sqlite3_open_v2(test_db, &db, 
        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE,
        "distsqlite");
    TEST_ASSERT(rc == SQLITE_OK, "Should open database");
    
    // Enable WAL mode
    rc = sqlite3_exec(db, "PRAGMA journal_mode=WAL", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should enable WAL mode");
    
    // Create and populate table
    rc = sqlite3_exec(db, "CREATE TABLE wal_test (id INTEGER PRIMARY KEY, data BLOB)", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should create table in WAL mode");
    
    // Insert larger data to trigger WAL writes
    const char *insert_sql = "INSERT INTO wal_test (data) VALUES (randomblob(1000))";
    for (int i = 0; i < 100; i++) {
        rc = sqlite3_exec(db, insert_sql, NULL, NULL, NULL);
        TEST_ASSERT(rc == SQLITE_OK, "Should insert blob data");
    }
    
    // Verify WAL file exists
    struct stat st;
    TEST_ASSERT(stat(test_wal, &st) == 0, "WAL file should exist");
    TEST_ASSERT(st.st_size > 0, "WAL file should have content");
    
    // Checkpoint
    rc = sqlite3_exec(db, "PRAGMA wal_checkpoint", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should checkpoint WAL");
    
    sqlite3_close(db);
    cleanup_test_files();
    TEST_SUCCESS();
}

// Test concurrent read operations
int test_concurrent_reads() {
    cleanup_test_files();
    
    // Create and populate database
    sqlite3 *write_db;
    int rc = sqlite3_open_v2(test_db, &write_db, 
        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE,
        "distsqlite");
    TEST_ASSERT(rc == SQLITE_OK, "Should open write database");
    
    rc = sqlite3_exec(write_db, "PRAGMA journal_mode=WAL", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should enable WAL mode");
    
    rc = sqlite3_exec(write_db, "CREATE TABLE concurrent (id INTEGER PRIMARY KEY, value INTEGER)", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should create table");
    
    // Insert test data
    for (int i = 0; i < 10; i++) {
        char sql[256];
        snprintf(sql, sizeof(sql), "INSERT INTO concurrent VALUES (%d, %d)", i, i * 100);
        rc = sqlite3_exec(write_db, sql, NULL, NULL, NULL);
        TEST_ASSERT(rc == SQLITE_OK, "Should insert data");
    }
    
    // Open multiple read connections
    sqlite3 *readers[5];
    for (int i = 0; i < 5; i++) {
        rc = sqlite3_open_v2(test_db, &readers[i], 
            SQLITE_OPEN_READONLY,
            "distsqlite");
        TEST_ASSERT(rc == SQLITE_OK, "Should open reader connection");
    }
    
    // Concurrent reads
    for (int i = 0; i < 5; i++) {
        sqlite3_stmt *stmt;
        rc = sqlite3_prepare_v2(readers[i], "SELECT SUM(value) FROM concurrent", -1, &stmt, NULL);
        TEST_ASSERT(rc == SQLITE_OK, "Should prepare read query");
        
        rc = sqlite3_step(stmt);
        TEST_ASSERT(rc == SQLITE_ROW, "Should have result");
        
        int sum = sqlite3_column_int(stmt, 0);
        TEST_ASSERT(sum == 4500, "Sum should be correct");
        
        sqlite3_finalize(stmt);
    }
    
    // Close all connections
    for (int i = 0; i < 5; i++) {
        sqlite3_close(readers[i]);
    }
    sqlite3_close(write_db);
    
    cleanup_test_files();
    TEST_SUCCESS();
}

// Test file locking
int test_file_locking() {
    cleanup_test_files();
    
    sqlite3 *db1, *db2;
    int rc;
    
    // Open first connection
    rc = sqlite3_open_v2(test_db, &db1, 
        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE,
        "distsqlite");
    TEST_ASSERT(rc == SQLITE_OK, "Should open first connection");
    
    rc = sqlite3_exec(db1, "CREATE TABLE lock_test (id INTEGER)", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should create table");
    
    // Start transaction on first connection
    rc = sqlite3_exec(db1, "BEGIN IMMEDIATE", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should begin transaction");
    
    // Open second connection
    rc = sqlite3_open_v2(test_db, &db2, 
        SQLITE_OPEN_READWRITE,
        "distsqlite");
    TEST_ASSERT(rc == SQLITE_OK, "Should open second connection");
    
    // Try to write from second connection (should fail)
    rc = sqlite3_exec(db2, "INSERT INTO lock_test VALUES (1)", NULL, NULL, NULL);
    TEST_ASSERT(rc != SQLITE_OK, "Write should fail due to lock");
    
    // Commit first transaction
    rc = sqlite3_exec(db1, "COMMIT", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should commit transaction");
    
    // Now second connection should succeed
    rc = sqlite3_exec(db2, "INSERT INTO lock_test VALUES (2)", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Write should succeed after lock release");
    
    sqlite3_close(db1);
    sqlite3_close(db2);
    
    cleanup_test_files();
    TEST_SUCCESS();
}

// Test large file operations
int test_large_file_ops() {
    cleanup_test_files();
    
    sqlite3 *db;
    int rc = sqlite3_open_v2(test_db, &db, 
        SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE,
        "distsqlite");
    TEST_ASSERT(rc == SQLITE_OK, "Should open database");
    
    // Create table with blob column
    rc = sqlite3_exec(db, "CREATE TABLE large_data (id INTEGER PRIMARY KEY, data BLOB)", NULL, NULL, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should create table");
    
    // Insert 10MB of data
    sqlite3_stmt *stmt;
    rc = sqlite3_prepare_v2(db, "INSERT INTO large_data (data) VALUES (?)", -1, &stmt, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should prepare insert");
    
    size_t blob_size = 10 * 1024 * 1024; // 10MB
    void *blob_data = malloc(blob_size);
    TEST_ASSERT(blob_data != NULL, "Should allocate blob memory");
    memset(blob_data, 0xAB, blob_size); // Fill with pattern
    
    sqlite3_bind_blob(stmt, 1, blob_data, blob_size, SQLITE_STATIC);
    rc = sqlite3_step(stmt);
    TEST_ASSERT(rc == SQLITE_DONE, "Should insert large blob");
    
    sqlite3_finalize(stmt);
    
    // Read back and verify
    rc = sqlite3_prepare_v2(db, "SELECT data FROM large_data WHERE id = 1", -1, &stmt, NULL);
    TEST_ASSERT(rc == SQLITE_OK, "Should prepare select");
    
    rc = sqlite3_step(stmt);
    TEST_ASSERT(rc == SQLITE_ROW, "Should have result");
    
    const void *read_data = sqlite3_column_blob(stmt, 0);
    int read_size = sqlite3_column_bytes(stmt, 0);
    TEST_ASSERT(read_size == blob_size, "Blob size should match");
    TEST_ASSERT(memcmp(read_data, blob_data, 1024) == 0, "Blob data should match");
    
    sqlite3_finalize(stmt);
    free(blob_data);
    sqlite3_close(db);
    
    cleanup_test_files();
    TEST_SUCCESS();
}

// Run all tests
int main(int argc, char **argv) {
    printf("=== DistSQLite VFS Unit Tests ===\n\n");
    
    int failed = 0;
    
    // Note: These tests assume the VFS is already initialized
    // In real usage, distVFSInit() would be called first
    
    failed += test_vfs_registration();
    failed += test_basic_operations();
    failed += test_wal_mode();
    failed += test_concurrent_reads();
    failed += test_file_locking();
    failed += test_large_file_ops();
    
    printf("\n=== Test Summary ===\n");
    if (failed == 0) {
        printf("All tests passed!\n");
        return 0;
    } else {
        printf("%d tests failed!\n", failed);
        return 1;
    }
}
</file>

<file path="test/config.yaml">
# DistSQLite Test Configuration
# This file configures test behavior and thresholds

test_settings:
  # Test timeouts
  unit_test_timeout: "30s"
  integration_test_timeout: "60s"
  benchmark_timeout: "120s"
  
  # Performance thresholds
  performance:
    min_ipc_events_per_sec: 100000
    max_failover_time: "1s"
    min_bulk_sync_speedup: 5.0  # Should be 5x faster than baseline
    
  # Concurrency settings
  concurrency:
    max_writers: 20
    writes_per_worker: 1000
    contention_retry_limit: 3
    
  # Error injection settings
  error_injection:
    corruption_test_enabled: true
    network_failure_test_enabled: true
    disk_full_test_enabled: false  # Disabled by default (destructive)
    
  # Split-brain prevention
  split_brain:
    fence_token_required: true
    max_lease_holders: 1
    lease_timeout: "5s"

# Test data configurations
test_data:
  small_dataset:
    rows: 1000
    bytes_per_row: 100
    
  medium_dataset:
    rows: 10000
    bytes_per_row: 1024
    
  large_dataset:
    rows: 100000
    bytes_per_row: 100
    
  huge_dataset:
    rows: 1000000
    bytes_per_row: 100

# Database configurations for testing
database_configs:
  wal_mode:
    journal_mode: "WAL"
    synchronous: "NORMAL"
    cache_size: 2000
    
  delete_mode:
    journal_mode: "DELETE"
    synchronous: "FULL"
    cache_size: 1000
    
  memory_mode:
    journal_mode: "MEMORY"
    synchronous: "OFF"
    cache_size: 10000

# Network test configurations
network_tests:
  slow_network:
    latency: "100ms"
    bandwidth: "1Mbps"
    
  unstable_network:
    packet_loss: 0.1
    jitter: "50ms"
    
  partition_test:
    partition_duration: "5s"
    recovery_time: "2s"

