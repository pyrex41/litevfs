    0: "abc123...",
    1: "def456...",
    // ... hashes from replica
}

diffPages, err := distcore.ComputeDiffPages(pages, replicaHashes)
log.Printf("Need to sync %d pages out of %d total", 
           len(diffPages), len(pages))
```

### Monitoring and Statistics
