(** Type-safe lease state machine for distributed coordination *)

type state =
  | Follower of { leader: string; fence: int64 }
  | Candidate of { election_timeout: float }
  | Leader of { fence: int64; expires_at: float }
  | Expired

type event =
  | Tick of float
  | LeaseAcquired of { fence: int64 }
  | LeaseExpired
  | NetworkPartition
  | LeaderHeartbeat of { from: string; fence: int64 }

type action =
  | StartElection
  | RenewLease
  | NotifyFollowers
  | BecomeFollower of string

(** Type-safe state transitions with exhaustive pattern matching *)
let transition state event =
  match state, event with
  
  (* Follower state transitions *)
  | Follower { leader; fence }, Tick current_time ->
      (* Stay in follower state, no actions needed *)
      state, []
      
  | Follower { leader; fence }, LeaderHeartbeat { from; fence = new_fence } ->
      if new_fence > fence then
        (* New leader with higher fence token *)
        Follower { leader = from; fence = new_fence }, []
      else if String.equal from leader && new_fence = fence then
        (* Heartbeat from current leader *)
        state, []
      else
        (* Ignore stale heartbeat *)
        state, []
        
  | Follower _, LeaseExpired ->
      (* Leader lease expired, start election *)
      Candidate { election_timeout = Unix.time () +. 5.0 }, [StartElection]
      
  | Follower _, NetworkPartition ->
      (* Network partition detected, become candidate *)
      Candidate { election_timeout = Unix.time () +. 10.0 }, [StartElection]
      
  | Follower _, LeaseAcquired { fence } ->
      (* We acquired the lease, become leader *)
      Leader { fence; expires_at = Unix.time () +. 30.0 }, [NotifyFollowers]
  
  (* Candidate state transitions *)
  | Candidate { election_timeout }, Tick current_time ->
      if current_time >= election_timeout then
        (* Election timeout, become expired *)
        Expired, []
      else
        (* Still in election period *)
        state, []
        
  | Candidate _, LeaseAcquired { fence } ->
      (* Won the election *)
      Leader { fence; expires_at = Unix.time () +. 30.0 }, [NotifyFollowers]
      
  | Candidate _, LeaderHeartbeat { from; fence } ->
      (* Another node became leader *)
      Follower { leader = from; fence }, [BecomeFollower from]
      
  | Candidate _, NetworkPartition ->
      (* Network partition during election, extend timeout *)
      Candidate { election_timeout = Unix.time () +. 15.0 }, []
      
  | Candidate _, LeaseExpired ->
      (* Keep trying to acquire lease *)
      state, [StartElection]
  
  (* Leader state transitions *)
  | Leader { fence; expires_at }, Tick current_time ->
      if current_time >= expires_at -. 10.0 then
        (* Lease expiring soon, renew it *)
        state, [RenewLease]
      else
        (* Still valid leader *)
        state, []
        
  | Leader { fence; expires_at }, LeaseAcquired { fence = new_fence } ->
      (* Successfully renewed lease *)
      Leader { fence = new_fence; expires_at = Unix.time () +. 30.0 }, []
      
  | Leader _, LeaseExpired ->
      (* Lost leadership *)
      Expired, []
      
  | Leader { fence; _ }, LeaderHeartbeat { from; fence = new_fence } ->
      if new_fence > fence then
        (* Another node has higher fence token, step down *)
        Follower { leader = from; fence = new_fence }, [BecomeFollower from]
      else
        (* Ignore heartbeat from lower fence token *)
        state, []
        
  | Leader _, NetworkPartition ->
      (* Network partition as leader, step down to be safe *)
      Expired, []
  
  (* Expired state transitions *)
  | Expired, Tick _ ->
      (* Try to become candidate after some delay *)
      let random_delay = Random.float 5.0 +. 2.0 in
      Candidate { election_timeout = Unix.time () +. random_delay }, [StartElection]
      
  | Expired, LeaderHeartbeat { from; fence } ->
      (* A leader emerged, become follower *)
      Follower { leader = from; fence }, [BecomeFollower from]
      
  | Expired, LeaseAcquired { fence } ->
      (* We acquired the lease *)
      Leader { fence; expires_at = Unix.time () +. 30.0 }, [NotifyFollowers]
      
  | Expired, NetworkPartition ->
      (* Stay expired during partition *)
      state, []
      
  | Expired, LeaseExpired ->
      (* Already expired, no change *)
      state, []

(** Get current state type as string for debugging *)
let state_name = function
  | Follower _ -> "Follower"
  | Candidate _ -> "Candidate"
  | Leader _ -> "Leader"
  | Expired -> "Expired"

(** Check if state is in a leadership role *)
let is_leader = function
  | Leader _ -> true
  | _ -> false

(** Check if state can accept writes *)
let can_write = function
  | Leader { expires_at; _ } -> Unix.time () < expires_at
  | _ -> false

(** Get fence token from current state *)
let get_fence_token = function
  | Follower { fence; _ } -> Some fence
  | Leader { fence; _ } -> Some fence
  | Candidate _ -> None
  | Expired -> None

(** Get leader identity from current state *)
let get_leader = function
  | Follower { leader; _ } -> Some leader
  | Leader _ -> Some "self"
  | Candidate _ -> None
  | Expired -> None

(** State machine runner for continuous operation *)
module Runner = struct
  type t = {
    mutable state: state;
    mutable last_tick: float;
    action_callback: action -> unit;
  }
  
  let create initial_state action_callback =
    {
      state = initial_state;
      last_tick = Unix.time ();
      action_callback;
    }
  
  let process_event runner event =
    let new_state, actions = transition runner.state event in
    runner.state <- new_state;
    List.iter runner.action_callback actions
  
  let tick runner =
    let current_time = Unix.time () in
    runner.last_tick <- current_time;
    process_event runner (Tick current_time)
  
  let get_state runner = runner.state
  
  (** Auto-tick runner for background operation *)
  let run_background runner interval =
    let rec loop () =
      tick runner;
      Thread.delay interval;
      loop ()
    in
    Thread.create loop ()
end

(** Validation functions *)
let validate_transition old_state new_state =
  match old_state, new_state with
  (* Valid transitions *)
  | Follower _, Candidate _ -> true
  | Follower _, Leader _ -> true
  | Candidate _, Follower _ -> true
  | Candidate _, Leader _ -> true
  | Candidate _, Expired -> true
  | Leader _, Follower _ -> true
  | Leader _, Expired -> true
  | Expired, Candidate _ -> true
  | Expired, Follower _ -> true
  | Expired, Leader _ -> true
  (* Same state is always valid *)
  | s1, s2 when s1 = s2 -> true
  (* Invalid transitions *)
  | _ -> false

(** Metrics and observability *)
module Metrics = struct
  type transition_stats = {
    mutable follower_to_candidate: int;
    mutable candidate_to_leader: int;
    mutable leader_to_follower: int;
    mutable leader_to_expired: int;
    mutable expired_to_candidate: int;
    mutable total_transitions: int;
  }
  
  let create_stats () = {
    follower_to_candidate = 0;
    candidate_to_leader = 0;
    leader_to_follower = 0;
    leader_to_expired = 0;
    expired_to_candidate = 0;
    total_transitions = 0;
  }
  
  let record_transition stats old_state new_state =
    if old_state <> new_state then begin
      stats.total_transitions <- stats.total_transitions + 1;
      match old_state, new_state with
      | Follower _, Candidate _ -> 
          stats.follower_to_candidate <- stats.follower_to_candidate + 1
      | Candidate _, Leader _ ->
          stats.candidate_to_leader <- stats.candidate_to_leader + 1
      | Leader _, Follower _ ->
          stats.leader_to_follower <- stats.leader_to_follower + 1
      | Leader _, Expired ->
          stats.leader_to_expired <- stats.leader_to_expired + 1
      | Expired, Candidate _ ->
          stats.expired_to_candidate <- stats.expired_to_candidate + 1
      | _ -> ()
    end
  
  let get_stats stats = [
    ("follower_to_candidate", stats.follower_to_candidate);
    ("candidate_to_leader", stats.candidate_to_leader);
    ("leader_to_follower", stats.leader_to_follower);
    ("leader_to_expired", stats.leader_to_expired);
    ("expired_to_candidate", stats.expired_to_candidate);
    ("total_transitions", stats.total_transitions);
  ]
end
</file>

<file path="src/vfs_intercept.ml">
(** Enhanced VFS with SQLite page interception for sqlite3_rsync compatibility *)

open Bigarray

type page_num = int
type page_data = (char, int8_unsigned_elt, c_layout) Array1.t
type page_hash = string

(** Page tracking state *)
module PageTracker = struct
  type page_state = 
    | Clean of page_hash
    | Dirty of page_data
    | New of page_data
  
  type t = {
    page_size: int;
    pages: (page_num, page_state) Hashtbl.t;
    dirty_pages: page_num Queue.t;
    mutable total_pages: int;
  }
  
  let create page_size = {
    page_size;
    pages = Hashtbl.create 10000;
    dirty_pages = Queue.create ();
    total_pages = 0;
  }
  
  let mark_page_dirty tracker page_num data =
    let old_state = Hashtbl.find_opt tracker.pages page_num in
    match old_state with
    | None | Some (Clean _) ->
        Hashtbl.replace tracker.pages page_num (Dirty data);
        Queue.add page_num tracker.dirty_pages
    | Some (Dirty _) ->
        Hashtbl.replace tracker.pages page_num (Dirty data)
    | Some (New _) ->
        Hashtbl.replace tracker.pages page_num (New data)
  
  let get_page_hash tracker page_num =
    match Hashtbl.find_opt tracker.pages page_num with
    | Some (Clean hash) -> Some hash
    | Some (Dirty data) | Some (New data) ->
        let hash = Binary_diff.hash_page data 0 (Array1.dim data) in
        Some hash
    | None -> None
  
  let get_dirty_pages tracker =
    let result = ref [] in
    try
      while true do
        let page_num = Queue.take tracker.dirty_pages in
        result := page_num :: !result
      done;
      !result
    with Queue.Empty -> !result
end

(** VFS file handle with page tracking *)
type vfs_file = {
  base_file: Nativeint.t; (* Opaque pointer to base VFS file *)
  tracker: PageTracker.t;
  mutable intercept_enabled: bool;
  db_path: string;
}

(** SQLite VFS method implementations *)
let vfs_read file buffer offset amount =
  let page_num = Int64.to_int (Int64.div offset (Int64.of_int file.tracker.page_size)) in
  
  if file.intercept_enabled then begin
    (* Check if we have intercepted data *)
    match Hashtbl.find_opt file.tracker.pages page_num with
    | Some (Dirty data) | Some (New data) ->
        (* Use intercepted data *)
        let page_offset = Int64.to_int (Int64.rem offset (Int64.of_int file.tracker.page_size)) in
        let copy_len = min amount (Array1.dim data - page_offset) in
        for i = 0 to copy_len - 1 do
          Array1.set buffer i (Array1.get data (page_offset + i))
        done;
        copy_len
    | _ ->
        (* Fall back to base VFS *)
        vfs_base_read file.base_file buffer offset amount
  end else
    vfs_base_read file.base_file buffer offset amount

let vfs_write file buffer offset amount =
  let page_num = Int64.to_int (Int64.div offset (Int64.of_int file.tracker.page_size)) in
  let page_offset = Int64.to_int (Int64.rem offset (Int64.of_int file.tracker.page_size)) in
  
  if file.intercept_enabled then begin
    (* Get or create page data *)
    let page_data = 
      match Hashtbl.find_opt file.tracker.pages page_num with
      | Some (Dirty data) | Some (New data) -> 
          Array1.create char c_layout (Array1.dim data) |> fun new_data ->
          Array1.blit data new_data; new_data
      | Some (Clean _) | None ->
          (* Create new page, potentially reading existing data first *)
          let new_data = Array1.create char c_layout file.tracker.page_size in
          if page_offset > 0 then begin
            (* Need to preserve existing data before the write *)
            let temp_buffer = Array1.create char c_layout file.tracker.page_size in
            let page_start = Int64.mul (Int64.of_int page_num) (Int64.of_int file.tracker.page_size) in
            let read_amount = vfs_base_read file.base_file temp_buffer page_start file.tracker.page_size in
            if read_amount > 0 then
              Array1.blit temp_buffer new_data
          end;
          new_data
    in
    
    (* Update the page data *)
    for i = 0 to amount - 1 do
      if page_offset + i < Array1.dim page_data then
        Array1.set page_data (page_offset + i) (Array1.get buffer i)
    done;
    
    (* Mark page as dirty *)
    PageTracker.mark_page_dirty file.tracker page_num page_data
  end;
  
  (* Also write to actual file *)
  vfs_base_write file.base_file buffer offset amount

(** External base VFS functions - implemented in C stubs *)
external vfs_base_read : Nativeint.t -> (char, int8_unsigned_elt, c_layout) Array1.t -> int64 -> int -> int = "caml_vfs_base_read"
external vfs_base_write : Nativeint.t -> (char, int8_unsigned_elt, c_layout) Array1.t -> int64 -> int -> int = "caml_vfs_base_write"
external vfs_base_close : Nativeint.t -> int = "caml_vfs_base_close"

(** High-level sync integration *)
module SyncIntegration = struct
  (** Write event enhanced with page information *)
  type enhanced_write_event = {
    path: string;
    offset: int64;
    data: (char, int8_unsigned_elt, c_layout) Array1.t;
    is_wal: bool;
    fence_token: int64;
    page_num: int;
    page_hash: string;
  }
  
  (** Convert VFS write to enhanced write event *)
  let create_enhanced_event file offset data =
    let page_num = Int64.to_int (Int64.div offset (Int64.of_int file.tracker.page_size)) in
    let page_hash = match PageTracker.get_page_hash file.tracker page_num with
      | Some hash -> hash
      | None -> Binary_diff.hash_page data 0 (Array1.dim data)
    in
    {
      path = file.db_path;
      offset;
      data;
      is_wal = String.contains file.db_path 'w'; (* Simple WAL detection *)
      fence_token = 0L; (* Would be set by caller *)
      page_num;
      page_hash;
    }
  
  (** Get all pages that need syncing *)
  let get_sync_pages file =
    let dirty_pages = PageTracker.get_dirty_pages file.tracker in
    List.map (fun page_num ->
      match Hashtbl.find_opt file.tracker.pages page_num with
      | Some (Dirty data) | Some (New data) ->
          let hash = Binary_diff.hash_page data 0 (Array1.dim data) in
          (page_num, hash, data)
      | _ -> failwith "Page not found"
    ) dirty_pages
  
  (** Compare with replica hashes to determine what to send *)
  let compute_diff_pages local_pages replica_hashes =
    List.filter (fun (page_num, local_hash, _data) ->
      match List.assoc_opt page_num replica_hashes with
      | Some replica_hash -> not (String.equal local_hash replica_hash)
      | None -> true (* New page *)
    ) local_pages
end

(** OCaml callbacks for VFS integration *)
let () =
  Callback.register "vfs_intercept_read" vfs_read;
  Callback.register "vfs_intercept_write" vfs_write;
  Callback.register "create_page_tracker" PageTracker.create;
  Callback.register "get_sync_pages" SyncIntegration.get_sync_pages
</file>

